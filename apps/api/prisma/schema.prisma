```prisma
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  USER
  MODERATOR
  ADMIN
}

enum SkillType {
  OFFERED
  WANTED
}

enum Proficiency {
  BEGINNER
  INTERMEDIATE
  ADVANCED
  EXPERT
}

enum ExchangeStatus {
  PENDING
  ACCEPTED
  ACTIVE
  COMPLETED
  REJECTED
  CANCELLED
}

enum SessionStatus {
  PROPOSED
  SCHEDULED
  COMPLETED
  CANCELLED
  MISSED
}

enum NotificationType {
  EXCHANGE_REQUEST
  EXCHANGE_ACCEPTED
  EXCHANGE_REJECTED
  SESSION_REMINDER
  NEW_MESSAGE
  NEW_REVIEW
  SYSTEM
}

enum ReportStatus {
  OPEN
  UNDER_REVIEW
  RESOLVED
  DISMISSED
}

model User {
  id                 String   @id @default(cuid())
  name               String
  email              String   @unique
  passwordHash       String
  bio                String?  @db.Text
  avatarUrl          String?
  location           String?
  timeZone           String?  @default("UTC")
  isEmailVerified    Boolean  @default(false)
  isActive           Boolean  @default(true)
  role               UserRole @default(USER)
  averageRating      Float    @default(0)
  completedExchanges Int      @default(0)
  reputationPoints   Int      @default(0)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  skills             Skill[]
  sentExchanges      Exchange[] @relation("ExchangeRequester")
  receivedExchanges  Exchange[] @relation("ExchangeRecipient")
  sentMessages       Message[]  @relation("MessageSender")
  reviewsGiven       Review[]   @relation("ReviewAuthor")
  reviewsReceived    Review[]   @relation("ReviewRecipient")
  notifications      Notification[]
  sessions           LearningSession[]
  favorites          Favorite[]
  reportsMade        Report[]   @relation("ReportAuthor")
  reportsReceived    Report[]   @relation("ReportedUser")
  conversations      ConversationParticipant[]
  resetTokens        PasswordResetToken[]
  emailTokens        EmailVerificationToken[]
}

model Skill {
  id             String      @id @default(cuid())
  userId         String
  title          String
  description    String      @db.Text
  category       String
  type           SkillType
  proficiency    Proficiency
  tags           String[]    @default([])
  hoursAvailable Int         @default(1)
  isRemote       Boolean     @default(true)
  isPublished    Boolean     @default(true)
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  user           User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  offeredIn      Exchange[]  @relation("OfferedSkill")
  wantedIn       Exchange[]  @relation("WantedSkill")
  favorites      Favorite[]

  @@index([userId])
  @@index([category])
  @@index([type, isPublished])
}

model Exchange {
  id              String         @id @default(cuid())
  requesterId     String
  recipientId     String
  offeredSkillId  String
  wantedSkillId   String
  message         String         @db.Text
  proposedMinutes Int            @default(60)
  status          ExchangeStatus @default(PENDING)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  completedAt     DateTime?

  requester       User           @relation("ExchangeRequester", fields: [requesterId], references: [id], onDelete: Restrict)
  recipient       User           @relation("ExchangeRecipient", fields: [recipientId], references: [id], onDelete: Restrict)
  offeredSkill    Skill          @relation("OfferedSkill", fields: [offeredSkillId], references: [id], onDelete: Restrict)
  wantedSkill     Skill          @relation("WantedSkill", fields: [wantedSkillId], references: [id], onDelete: Restrict)
  sessions        LearningSession[]
  reviews         Review[]

  @@index([requesterId, status])
  @@index([recipientId, status])
}

model LearningSession {
  id          String        @id @default(cuid())
  exchangeId  String
  createdById String
  title       String
  description String?       @db.Text
  startAt     DateTime
  endAt       DateTime
  meetingUrl  String?
  status      SessionStatus @default(PROPOSED)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  exchange    Exchange      @relation(fields: [exchangeId], references: [id], onDelete: Cascade)
  createdBy   User          @relation(fields: [createdById], references: [id], onDelete: Restrict)

  @@index([exchangeId, startAt])
}

model Conversation {
  id           String   @id @default(cuid())
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  participants ConversationParticipant[]
  messages     Message[]
}

model ConversationParticipant {
  id             String       @id @default(cuid())
  conversationId String
  userId         String
  joinedAt       DateTime     @default(now())

  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([conversationId, userId])
  @@index([userId])
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  senderId       String
  body           String       @db.Text
  readAt         DateTime?
  createdAt      DateTime     @default(now())

  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender         User         @relation("MessageSender", fields: [senderId], references: [id], onDelete: Restrict)

  @@index([conversationId, createdAt])
}

model Review {
  id          String   @id @default(cuid())
  exchangeId  String
  authorId    String
  recipientId String
  rating      Int
  comment     String?  @db.Text
  createdAt   DateTime @default(now())

  exchange    Exchange @relation(fields: [exchangeId], references: [id], onDelete: Cascade)
  author      User     @relation("ReviewAuthor", fields: [authorId], references: [id], onDelete: Restrict)
  recipient   User     @relation("ReviewRecipient", fields: [recipientId], references: [id], onDelete: Restrict)

  @@unique([exchangeId, authorId])
  @@index([recipientId, createdAt])
}

model Favorite {
  id        String   @id @default(cuid())
  userId    String
  skillId   String
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  skill     Skill    @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@unique([userId, skillId])
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  type      NotificationType
  title     String
  body      String           @db.Text
  link      String?
  readAt    DateTime?
  createdAt DateTime         @default(now())

  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt, createdAt])
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model EmailVerificationToken {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Report {
  id             String       @id @default(cuid())
  authorId       String
  reportedUserId String?
  targetType     String
  targetId       String
  reason         String
  details        String?      @db.Text
  status         ReportStatus @default(OPEN)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  author         User         @relation("ReportAuthor", fields: [authorId], references: [id], onDelete: Restrict)
  reportedUser   User?        @relation("ReportedUser", fields: [reportedUserId], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
}
```
