```json
{
  "name": "skill-barter-board",
  "version": "1.0.0",
  "private": true,
  "description": "A full-stack platform for skill exchange and collaborative learning",
  "workspaces": [
    "apps/web",
    "apps/api",
    "packages/shared"
  ],
  "scripts": {
    "dev": "concurrently -k -n API,WEB \"npm run dev:api\" \"npm run dev:web\"",
    "dev:api": "npm run dev --workspace=@skill-barter/api",
    "dev:web": "npm run dev --workspace=@skill-barter/web",
    "build": "npm run build --workspace=@skill-barter/shared && npm run build --workspace=@skill-barter/api && npm run build --workspace=@skill-barter/web",
    "test": "npm run test --workspace=@skill-barter/api && npm run test --workspace=@skill-barter/web"
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "typescript": "^5.8.3"
  },
  "engines": {
    "node": ">=22"
  }
}
```
